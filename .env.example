# Required: PostgreSQL SQLAlchemy async URL.
DATABASE_URL=postgresql+asyncpg://farmtrack:change-me@localhost:5432/farmtrack

# Required: replace with a unique locally generated key (32+ characters).
JWT_SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-characters

# Optional application settings.
ENVIRONMENT=development
DEBUG=false
TIMEZONE=Africa/Nairobi
CORS_ORIGINS=http://localhost:8081,http://localhost:8083

# Per API process; account for every instance and worker in the DB connection budget.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Configure your Gmail account and Google app password to enable farm invitation emails.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-account@gmail.com
# SMTP_PASSWORD=your-16-character-google-app-password
# SMTP_FROM_EMAIL=your-account@gmail.com
# FARMTRACK_APP_URL=farmtrack://farm-team

# Private GitHub repository for Android APK releases.
# APP_RELEASE_ADMIN_EMAILS=admin1@example.com,admin2@example.com
# GITHUB_RELEASE_REPOSITORY=your-owner/your-backend-repository
# GITHUB_RELEASE_TOKEN=your-server-only-fine-grained-token
# APP_PUBLIC_BASE_URL=https://your-backend.onrender.com
# DOWNLOAD_TOKEN_EXPIRY_DAYS=7

# Optional logging settings.
LOG_LEVEL=INFO
LOG_DIR=logs
