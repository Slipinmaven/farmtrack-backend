# Required: PostgreSQL SQLAlchemy async URL.
DATABASE_URL=postgresql+asyncpg://farmtrack:change-me@localhost:5432/farmtrack

# Required: replace with a unique locally generated key (32+ characters).
JWT_SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-characters

# Optional application settings.
ENVIRONMENT=development
DEBUG=false
TIMEZONE=Africa/Nairobi
CORS_ORIGINS=http://localhost:8081,http://localhost:8083

# Per API process; account for every instance and worker in the DB connection budget.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Optional logging settings.
LOG_LEVEL=INFO
LOG_DIR=logs
