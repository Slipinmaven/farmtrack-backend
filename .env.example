# Required: PostgreSQL SQLAlchemy async URL.
DATABASE_URL=postgresql+asyncpg://farmtrack:change-me@localhost:5432/farmtrack

# Required: replace with a unique locally generated key (32+ characters).
JWT_SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-characters

# Optional application settings.
ENVIRONMENT=development
DEBUG=false
TIMEZONE=Africa/Nairobi
CORS_ORIGINS=http://localhost:8081,http://localhost:8083

# Per API process; account for every instance and worker in the DB connection budget.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Configure the Google Apps Script email gateway.
# EMAIL_GATEWAY_URL=https://script.google.com/macros/s/your-deployment-id/exec
# EMAIL_GATEWAY_SECRET=replace-with-your-gateway-secret
# EMAIL_GATEWAY_TIMEOUT_SECONDS=15
# Deep link to Team & invitations in an installed FarmTrack app.
# Use a device-reachable URL for Expo Go or browser testing; never email localhost.
# FARMTRACK_APP_URL=farmtrack://farm-team

# Private GitHub repository for Android APK releases.
# APP_RELEASE_ADMIN_EMAILS=admin1@example.com,admin2@example.com
# GITHUB_RELEASE_REPOSITORY=your-owner/your-backend-repository
# GITHUB_RELEASE_TOKEN=your-server-only-fine-grained-token
# Required for account deletion confirmation and APK links.
# APP_PUBLIC_BASE_URL=https://your-backend.onrender.com
# DOWNLOAD_TOKEN_EXPIRY_DAYS=7

# Optional server-only AI provider credentials. Requests fail over Groq -> Gemini -> OpenRouter.
# Configure only providers you intend to use. Provider keys are never sent to mobile clients.
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=qwen/qwen3.8-27b
# GEMINI_API_KEY=your-google-ai-studio-api-key
# GEMINI_MODEL=gemini-3-flash-preview
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_MODEL=openrouter/free

# Optional logging settings.
LOG_LEVEL=INFO
LOG_DIR=logs
